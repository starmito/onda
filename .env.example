# Onda — Configuración de despliegue
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env

# ── Raíz de datos ────────────────────────────
# Todos los datos de usuario (input/, output/, config/, logs/, models/, .cache/)
# viven bajo esta carpeta. En el contenedor se monta como /app/data.
ONDA_DATA_DIR=./data

# ── Fichero de ajustes persistentes ───────────
# Vive fuera de ONDA_DATA_DIR para sobrevivir a cambios de raíz y a recrear
# el contenedor. Se monta como /app/.onda-settings.json en el contenedor.
ONDA_SETTINGS_FILE=./.onda-settings.json

# ── Modelos ──────────────────────────────────
# Ruta donde están (o se descargarán) los modelos de separación.
# Puede ser absoluta (/datos/onda/models) o relativa (./models).
MODEL_DIR=./models

# ── Permisos ─────────────────────────────────
# UID/GID del usuario host (para que los archivos de salida tengan tus permisos).
# Déjalo en 1000 si es una instalación single-user estándar.
HOST_UID=1000
HOST_GID=1000

# ── Puertos ──────────────────────────────────
# Puerto donde se sirve la interfaz web.
ONDA_PORT=3000

# ── CORS ─────────────────────────────────────
# Orígenes permitidos para peticiones al backend. Lista separada por comas.
# Si no se define, se mantiene el comportamiento antiguo (Access-Control-Allow-Origin: *).
# Ejemplo: ONDA_CORS_ORIGINS=http://localhost:3000,https://onda.example.com
# ONDA_CORS_ORIGINS=

# ── Cachés persistentes (dentro de ONDA_DATA_DIR) ─
# En producción se heredan de ONDA_DATA_DIR; aquí se muestran para documentación.
# HF_HOME=${ONDA_DATA_DIR}/.cache/huggingface
# TORCH_HOME=${ONDA_DATA_DIR}/.cache/torch
# NUMBA_CACHE_DIR=${ONDA_DATA_DIR}/.cache/numba
# XDG_CACHE_HOME=${ONDA_DATA_DIR}/.cache/xdg
